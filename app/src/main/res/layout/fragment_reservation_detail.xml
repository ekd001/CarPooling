<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:background="@color/white">

<!-- Toolbar avec bouton de retour -->
<androidx.appcompat.widget.Toolbar
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/mainColor"
    android:elevation="6dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    app:titleTextColor="@color/white"
    app:navigationIcon="@drawable/ic_arrow_back"
     />

<!-- ScrollView pour permettre le défilement -->
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Étiquette d'état de la réservation -->
        <TextView
            android:id="@+id/reservationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/ic_confirmed"
            android:text="Confirmé"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:fontFamily="@font/gotham_medium"
            android:background="@drawable/reservation_confirmed_bg"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Date et heure de la réservation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                android:tint="@color/mainColor" />

            <TextView
                android:id="@+id/reservationDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12/10/2023"
                android:fontFamily="@font/gotham_bold"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/reservationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:00"
                android:fontFamily="@font/gotham_bold"
                android:textSize="16sp"
                android:textColor="@color/mainColor" />
        </LinearLayout>

        <!-- Détails du trajet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Détails du trajet"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/mainColor" />

                <TextView
                    android:id="@+id/trajetDepart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Départ : Paris"
                    android:fontFamily="@font/gotham_medium"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/mainColor" />

                <TextView
                    android:id="@+id/trajetDestination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Destination : Lyon"
                    android:fontFamily="@font/gotham_medium"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:paddingStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bouton "Contacter le conducteur" -->
        <Button
            android:id="@+id/contactButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contacter le conducteur"
            android:textSize="14sp"
            android:paddingVertical="12dp"
            android:backgroundTint="@color/mainColor"
            android:textColor="@color/white"
            android:fontFamily="@font/gotham_medium"
            android:elevation="2dp"
            android:stateListAnimator="@null"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
</LinearLayout>