<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="4dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Date, heure et étiquette d'état -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <!-- Icône de calendrier -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/calendar_icon" />

            <!-- Date de la réservation -->
            <TextView
                android:id="@+id/reservationDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12/10/2023"
                android:fontFamily="@font/gotham_bold"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:textColor="@color/black" />

            <!-- Heure de la réservation -->
            <TextView
                android:id="@+id/reservationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_bold"
                android:text="14:00"
                android:textSize="16sp"
                android:textColor="@color/mainColor"
                android:paddingEnd="8dp" />

            <!-- Étiquette d'état de la réservation -->
            <TextView
                android:id="@+id/reservationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:drawablePadding="8dp"
                android:drawableEnd="@drawable/ic_confirmed"
                android:text="Confirmé"
                android:textSize="18sp"
                android:background="@drawable/reservation_confirmed_bg"
                android:textColor="@color/white"
                android:fontFamily="@font/gotham_medium"
                android:layout_marginStart="16dp"
                android:elevation="4dp" />

        </LinearLayout>

        <!-- Séparateur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black"
            android:layout_marginVertical="8dp" />

        <!-- Détails du trajet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <!-- Icône de trajet -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/trajet_icon" />

            <!-- Détails du trajet (départ et destination) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <!-- Départ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Départ :"
                        android:fontFamily="@font/gotham_bold"
                        android:textSize="14sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/trajetDepartValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paris"
                        android:fontFamily="@font/gotham_medium"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:paddingStart="4dp" />
                </LinearLayout>

                <!-- Destination -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination :"
                        android:fontFamily="@font/gotham_bold"
                        android:textSize="14sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/trajetDestinationValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lyon"
                        android:fontFamily="@font/gotham_medium"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:paddingStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bouton "Contacter le conducteur" -->
            <ImageView
                android:id="@+id/contactButton"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/chat_icon"
                android:elevation="2dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>