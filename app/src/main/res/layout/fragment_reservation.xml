<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="tg.ulcrsandroid.carspooling.ReservationFragment">

    <!-- ScrollView pour permettre le défilement -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/mainColor"
            android:elevation="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/taxi_icon"
            app:title="Mes Réservations" />

        <!-- Conteneur principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Titre "Mes Réservations" -->


            <!-- RecyclerView pour afficher la liste des réservations -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reservationRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <!-- Message si la liste est vide -->
            <TextView
                android:id="@+id/emptyReservationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aucune réservation trouvée."
                android:textSize="16sp"
                android:textColor="@color/gray"
                android:gravity="center"
                android:visibility="gone"
                android:fontFamily="@font/gotham_medium"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>