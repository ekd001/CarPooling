<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Carte Google Maps -->
    <LinearLayout
        android:id="@+id/mapFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="62dp">

        <fragment
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

    <!-- Conteneur superposé -->
    <LinearLayout
        android:id="@+id/routeDetailsLayout"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="160dp"
        android:orientation="horizontal"
        android:elevation="10dp"
        android:gravity="center"
        android:padding="16dp"
        android:layout_gravity="top">

        <!-- Icône de retour -->
        <ImageView
            android:id="@+id/backIconRoute"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/back_icon" />

        <!-- Diagramme de points -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:layout_marginTop="9dp"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/startIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/starting_icon"
                android:layout_marginBottom="5dp" />

            <View
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="6dp"
                android:background="@color/gray" />

            <ImageView
                android:id="@+id/destinationIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/destination_icon" />
        </LinearLayout>

        <!-- Champs de texte -->
        <LinearLayout
            android:layout_width="215dp"
            android:layout_height="110dp"
            android:orientation="vertical"
            android:layout_marginEnd="20dp"
            android:paddingTop="11dp" >

            <TextView
                android:id="@+id/startLocationText"
                android:background="@drawable/rounded_frame"
                android:layout_width="215dp"
                android:layout_height="40dp"
                android:fontFamily="@font/gotham_book"
                android:paddingStart="10dp"
                android:layout_marginBottom="10dp"
                android:text="Start Location"
                android:textSize="16sp"
                android:textColor="@color/mainColor"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1" />

            <TextView
                android:id="@+id/destinationText"
                android:background="@drawable/rounded_frame"
                android:layout_width="215dp"
                android:layout_height="40dp"
                android:fontFamily="@font/gotham_book"
                android:paddingStart="10dp"
                android:text="Destination"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        app:menu="@menu/bottom_nav_menu"
        style="@style/BottomNavigationViewStyle"
        android:layout_gravity="bottom" />

    <!-- Barre de recherche -->
    <LinearLayout
        android:id="@+id/searchField"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:orientation="horizontal"
        android:background="@drawable/maps_search_edit_text"
        android:padding="8dp"
        android:elevation="8dp"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/google_maps_icon" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/rechercher_un_endroit"
            android:fontFamily="@font/gotham_book"
            android:textSize="16sp"
            android:paddingStart="10dp"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <!-- RecyclerView des suggestions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestionsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="86dp"
        android:layout_gravity="top" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
