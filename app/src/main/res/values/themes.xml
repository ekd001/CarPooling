<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CarPooling" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mainColor</item>
    </style>

    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mainColor</item>
        <item name="android:windowBackground">@color/mainColor</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/BottomNavTextActive</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavTextInactive</item>
        <item name="itemPaddingTop">5dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="android:background">@color/mainColor</item>
    </style>

    <style name="BottomNavTextActive" parent="TextAppearance.AppCompat.Caption">
        <item name="fontFamily">@font/gotham_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/gotham_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomToolbarStyle" parent="Widget.AppCompat.Toolbar">
        <item name="android:fontFamily">@font/gotham_medium</item>
        <item name="fontFamily">@font/gotham_medium</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CustomDialogStyle" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/lowMainColor</item>
        <item name="colorAccent">@color/mainColor</item>

        <!-- On conserve les boutons avec leur style par défaut -->
        <item name="android:buttonBarPositiveButtonStyle">@style/CustomButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CustomButtonStyle</item>
    </style>

    <style name="CustomButtonStyle" parent="android:style/Widget.Button">
        <item name="android:textColor">@color/mainColor</item>
    </style>


    <style name="Theme.CarPooling" parent="Base.Theme.CarPooling" />
 </resources>